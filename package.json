{
  "name": "mihon-folder-library",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm install && npm run build:only",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "benchmark": "node benchmarks/catalog-benchmark.mjs",
    "benchmark:scan": "node benchmarks/scan-benchmark.mjs",
    "lint": "eslint server/ tests/",
    "lint:fix": "eslint server/ tests/ --fix",
    "format": "prettier --write server/ tests/"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0"
  }
}
